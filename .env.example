APP_NAME="MSP Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# Docker Compose in this repo talks to the `db` service (PostgreSQL 16).
# Uncomment the block below after `cp .env.example .env` (or keep sqlite for `php artisan serve`).
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=msp
# DB_USERNAME=msp
# DB_PASSWORD=secret

# UI is English-native. Fallback is always English. Browser language is used
# unless the operator picks another locale in the switcher.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
APP_DEMO_LOGIN=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (Laravel config/mail.php). Local: log. Production: smtp + real credentials
# in .env / Portainer — NEVER commit real secrets.
# Test: php artisan tinker --execute="Mail::raw('test', fn (\$m) => \$m->to('you@example.com')->subject('test'));"
# Portal magic-link mail uses the same MAIL_* config.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_SCHEME: null = STARTTLS on port 587; smtps = implicit TLS on port 465
# (Laravel 11+ “encryption”; there is no separate MAIL_ENCRYPTION).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Agent API (Laravel Sanctum personal access tokens)
# Create / revoke / reset from the admin UI: System → API tokens (or Users).
# See AGENT.md. Optional SPA stateful domains:
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Filament admin 2FA (TOTP) is optional per user via Profile; no extra env vars.
# Secrets are stored encrypted with APP_KEY — keep APP_KEY stable in production.

# -----------------------------------------------------------------------------
# Stripe (customer portal: iDEAL → SEPA auto-collect + invoices). See docs/PORTAL.md
# Local webhook: stripe listen --forward-to localhost:8000/stripe/webhook
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
