FROM php:8.4-fpm-alpine

# System deps + PHP extensions
RUN apk add --no-cache \
        bash git icu-dev libzip-dev zip unzip \
        postgresql-dev oniguruma-dev libpng-dev libjpeg-turbo-dev freetype-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo pdo_pgsql pgsql intl zip bcmath gd opcache exif pcntl

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/php/php.ini /usr/local/etc/php/conf.d/zz-app.ini

RUN addgroup -g 1000 app && adduser -u 1000 -G app -s /bin/bash -D app

WORKDIR /var/www/html

# Source in the image (no bind-mount in production).
COPY --chown=app:app . /var/www/html

# Always a valid quoted .env for artisan during build. Coolify may drop an
# unquoted runtime .env into the context; that must not be used here.
RUN rm -f .env \
    && cp .env.example .env \
    && composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev \
    && php artisan filament:assets \
    && cp -a public public-dist \
    && rm -f .env \
    && chown -R app:app storage bootstrap/cache public public-dist

# Entrypoint: wait for db, migrate, build caches (php-fpm only).
COPY --chmod=0755 docker/php/entrypoint.sh /usr/local/bin/entrypoint

USER app

EXPOSE 9000
ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]
