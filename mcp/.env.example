# Base URL of the Laravel app (no trailing slash). Requests go to {MSP_API_BASE}/api/v1/...
MSP_API_BASE=http://localhost

# Sanctum personal access token (Bearer). Create from admin UI: Systeem → API-tokens
# (or during first-run onboarding). Shown once; revoke/reset from the same screen.
MSP_API_TOKEN=your-plain-text-sanctum-token
