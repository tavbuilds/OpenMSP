# Production environment for docker-compose.prod.yml
# Same variables for Docker CLI, Coolify, Portainer, or a VPS/droplet.
# Copy to `.env` next to the compose file (CLI) or paste them into the host UI.
# Quote any value with spaces: APP_NAME="Tav IT Support"
# Do NOT commit real values. Notes: docs/SECRETS.md, DEPLOY.md
#
# app, queue, and scheduler receive this list identically.

# =============================================================================
# REQUIRED
# =============================================================================

# Generate ONCE and keep it stable. Encrypts license keys, 2FA, and UI secrets.
# Changing it makes existing ciphertext unreadable.
#   docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Strong, unique database password (Postgres POSTGRES_PASSWORD + app DB_PASSWORD).
DB_PASSWORD=

# Public URL — links in mail, Filament, Sanctum, portal magic links.
# HTTPS example: https://msp.example.com
APP_URL=http://your-host:8090

# Host port published by nginx (host:container = APP_PORT:80).
# Behind Coolify/Traefik/Caddy you can leave 8090; the proxy maps 443 → this port.
APP_PORT=8090

# true behind HTTPS (any reverse proxy). false only on plain http://IP:port.
SESSION_SECURE_COOKIE=false

# =============================================================================
# OPTIONAL — identity / locale / timezone
# =============================================================================

APP_NAME="MSP Platform"
APP_DEBUG=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Used by PHP dates AND the daily reminder schedule (08:00 in this zone).
APP_TIMEZONE=UTC

# Public demo login (test / test). Leave false on a real MSP install.
APP_DEMO_LOGIN=false

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database name/user (defaults msp/msp).
DB_DATABASE=msp
DB_USERNAME=msp

# =============================================================================
# SMTP — reminders, portal magic links
# Local/test: MAIL_MAILER=log. Production: smtp + credentials (not in Git).
# Same values can later be overridden from System → Settings.
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# empty/null on 587 (STARTTLS); smtps on 465.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=msp@yourdomain.com
MAIL_FROM_NAME="MSP Platform"

# =============================================================================
# Stripe — portal auto-collect (iDEAL → SEPA) + invoices. Optional.
# Passed through to app, queue, and scheduler. Enable iDEAL + SEPA in Stripe.
# You can also set these from System → Settings after first login.
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
