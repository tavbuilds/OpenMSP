# Environment variables for the production stack (docker-compose.prod.yml).
# In Portainer, set these under the stack’s “Environment variables”.
# Keep these values safe — do NOT commit them to Git.
# Full notes: docs/SECRETS.md

# =============================================================================
# REQUIRED — stable secrets
# =============================================================================

# Generate ONCE and keep it stable. Encrypts license keys and 2FA secrets.
# Changing it makes existing ciphertext unreadable.
# Generate:  docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Strong, unique database password (PostgreSQL POSTGRES_PASSWORD + app DB_PASSWORD).
DB_PASSWORD=

# =============================================================================
# REQUIRED — app / network
# =============================================================================

# Public URL (links in emails, Filament, Sanctum, portal magic links).
APP_URL=http://your-host:8090

# Host port (host:container = APP_PORT:80).
APP_PORT=8090

# true behind HTTPS (reverse proxy), otherwise false.
SESSION_SECURE_COOKIE=false

# Optional — database name/user (defaults msp/msp).
DB_DATABASE=msp
DB_USERNAME=msp

# English-native UI; English is also the fallback.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# =============================================================================
# SMTP — renewal reminders + portal magic links + other Laravel mail
# Same MAIL_* as config/mail.php; passed through to app, queue, scheduler.
# Local/test: MAIL_MAILER=log. Production: smtp + credentials here (not in Git).
# Test mail:
#   docker exec -it <app> php artisan tinker --execute="Mail::raw('MSP SMTP test', fn (\$m) => \$m->to('you@example.com')->subject('MSP SMTP test'));"
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Encryption/scheme (Laravel): empty/null on 587 (STARTTLS); smtps on 465.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=msp@yourdomain.com
MAIL_FROM_NAME="MSP Platform"

# =============================================================================
# Stripe — customer portal auto-collect (iDEAL → SEPA) + invoices
# See docs/PORTAL.md and docs/SECRETS.md. Enable iDEAL + SEPA DD in the Dashboard.
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
